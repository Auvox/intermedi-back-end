# Copie este arquivo para ".env" se quiser mudar algo (opcional).
# O .env não vai para o Git.

# Porta do servidor (padrão: 3000)
PORT=3000

# Caminho do banco (padrão: database/intermedi.main.db na main,
# database/intermedi.db nas demais branches)
# INTERMEDI_DB_PATH=database/intermedi.db

# Pasta das fotos de perfil (padrão: uploads/perfis)
# INTERMEDI_UPLOAD_DIR=uploads/perfis

# Pasta das fotos dos remédios (padrão: uploads/remedios)
# INTERMEDI_UPLOAD_REMEDIOS_DIR=uploads/remedios

# Tempo (em segundos) para o remédio de uma redistribuição chegar (padrão: 120)
# INTERMEDI_TEMPO_ENTREGA_SEGUNDOS=120
