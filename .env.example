# Copie este arquivo para ".env" se quiser mudar algo (opcional).
# O .env não vai para o Git.

# Porta do servidor (padrão: 3000)
PORT=3000

# Caminho do banco (padrão: database/intermedi.main.db na main,
# database/intermedi.db nas demais branches)
# INTERMEDI_DB_PATH=database/intermedi.db

# Pasta das fotos de perfil (padrão: uploads/perfis)
# INTERMEDI_UPLOAD_DIR=uploads/perfis

# Pasta das fotos dos remédios (padrão: uploads/remedios)
# INTERMEDI_UPLOAD_REMEDIOS_DIR=uploads/remedios

# Tempo (em segundos) para o remédio de uma redistribuição chegar (padrão: 120)
# INTERMEDI_TEMPO_ENTREGA_SEGUNDOS=120

# Pasta das fotos de funcionários, gerentes e farmácias (padrão: uploads/fotos)
# INTERMEDI_UPLOAD_FOTOS_DIR=uploads/fotos

# Preparo dos pedidos entre farmácias: caixas de 50 un., 5 s por ida e volta (padrão)
# INTERMEDI_UNIDADES_POR_CAIXA=50
# INTERMEDI_SEGUNDOS_POR_VIAGEM=5

# ---------------------------------------------------------------------
# Login da equipe (JWT)
# ---------------------------------------------------------------------
# Segredo que assina os tokens (mínimo 32 caracteres). Obrigatório em
# produção. Sem ele, em desenvolvimento, as sessões caem a cada reinício.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
# Duração da sessão em horas (padrão: 8)
# JWT_EXPIRA_HORAS=8

# ---------------------------------------------------------------------
# E-mail de boas-vindas (matrícula nova)
# ---------------------------------------------------------------------
# Sem SMTP_HOST o e-mail não é enviado: fica salvo como .html na pasta abaixo.
# INTERMEDI_EMAIL_DIR=tmp/emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_REMETENTE=Intermedi <nao-responda@seu-dominio.com>
# Endereço do front, usado no botão "Entrar no Intermedi" do e-mail
# INTERMEDI_FRONT_URL=http://localhost:5173
