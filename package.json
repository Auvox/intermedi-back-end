{
  "name": "intermedi-back-end",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "db:init": "node --env-file-if-exists=.env database/init.mjs",
    "db:seed": "node --env-file-if-exists=.env database/init.mjs --seed",
    "db:reset": "node --env-file-if-exists=.env database/init.mjs --reset",
    "db:publish": "node --env-file-if-exists=.env database/share.mjs publish",
    "db:sync": "node --env-file-if-exists=.env database/share.mjs sync",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  },
  "dependencies": {
    "msnodesqlv8": "^5.3.0",
    "mssql": "^12.7.0"
  }
}
